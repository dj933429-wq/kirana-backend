# ==============================================================================
# Kirana Backend — Environment Configuration Example (.env.example)
#
# SYSTEM REQUIREMENTS:
# - Node.js: >=20.19.0 (Required by Prisma 7.x)
# - PostgreSQL: >=14.0
#
# IMPORTANT FOR OPERATORS & DEVELOPERS:
# 1. Never commit a real .env file with secrets to version control.
# 2. Never run automated tests (npm test) against a production database.
# 3. In production, provide strong high-entropy secrets and explicit CORS origins.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMMON SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port the Express server listens on (Cloud Run injects PORT=8080; Local Default: 3000)
PORT=8080

# Node Environment Mode ('development' | 'production' | 'test')
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Runtime queries — pooled connection via Supavisor, port 6543
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI migrations only — direct connection, port 5432
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Database Connection Pool Size (Default: 5, Range: 1-100)
DATABASE_POOL_SIZE=5

# Database SSL Encryption (Default: false in development; true in production)
DATABASE_SSL=true

# Database SSL Certificate Verification (Default: true)
# Set to false ONLY if using cloud databases with self-signed provider certificates
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# JWT Secret Key:
# - In Development/Test: Min 8 chars allowed.
# - In Production: MUST be at least 32 characters long, high-entropy, no placeholders.
# Generate via: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-8-chars"

# JWT Token Lifetime (e.g. '1d', '7d', '12h')
JWT_EXPIRES_IN="1d"

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION (Frontend Origin Restriction)
# ------------------------------------------------------------------------------
# Allowed Frontend Origins:
# - In Development: '*' allows all local origins (e.g. http://localhost:5173, http://127.0.0.1:8080)
# - In Production: Comma-separated list of exact HTTPS domains (e.g. 'https://app.kiranaledger.com,https://admin.kiranaledger.com')
CORS_ALLOWED_ORIGINS="*"

# ------------------------------------------------------------------------------
# 5. RATE LIMITING (Brute-Force Login Protection)
# ------------------------------------------------------------------------------
# Time window in milliseconds for login attempt counting (Default: 900000 = 15 mins)
RATE_LIMIT_WINDOW_MS=900000

# Maximum failed/total login attempts allowed within the window (Default: 10)
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10
